DJANGO_SECRET_KEY={{ vault_secret_key }}
DJANGO_ALLOWED_HOSTS={{ domain }},www.{{ domain }}
POSTGRES_HOST=/var/run/postgresql
POSTGRES_PASSWORD=
{% if vault_email_password is defined %}
ALERT_EMAIL={{ admin_email }}
EMAIL_HOST={{ email_host }}
EMAIL_HOST_USER={{ admin_email }}
EMAIL_HOST_PASSWORD={{ vault_email_password }}
{% endif %}
{% if vault_github_token is defined %}
GITHUB_REPO={{ github_repo }}
GITHUB_TOKEN={{ vault_github_token }}
{% endif %}
{% if vault_github_webhook_secret is defined %}
GITHUB_WEBHOOK_SECRET={{ vault_github_webhook_secret }}
{% endif %}
